# --- model and data sources -------------------------------------------------
OPENAI_API_KEY=<YOUR_API_KEY_HERE>
DATA_GO_KR_FNCOINFO_ENDPOINT=https://apis.data.go.kr/1160100/service/GetFnCoBasiInfoService
DATA_GO_KR_FNCOINFO_AUTHKEY=<YOUR_AUTH_KEY_HERE>

# --- serving: the worker ----------------------------------------------------
# Defaults match core/context.py; set these only to override.
FDR_MODEL=gpt-5-mini
# Per-run caps. A run raises BudgetExceeded rather than spending past them.
FDR_MAX_CALLS=60
FDR_MAX_USD=1.0
# Keep at 1: core/usage.py keeps the run meter in a module-level global, so two runs in one
# process would share one budget.
FDR_AGENT_CONCURRENCY=1
# Host path to the rubric yaml folder, mounted read-only. The default is the sibling folder in
# the ABC Final Project directory; set it if your checkout sits elsewhere.
# FDR_RUBRIC_HOST_DIR=../../05 법령·지침 원문 검증/카드사 가드레일 루브릭

# --- serving: the gateway ---------------------------------------------------
# REQUIRED. The issued API token, sent by callers as `Authorization: Bearer <token>`.
# The gateway refuses to start without it — there is no unauthenticated mode.
# Issue one with:  uv run python -m financial_disclosure_review.serving.token
# Comma-separated values are accepted so an old and a new token can both be live during a
# rotation; withdraw the old one once every caller has moved.
FDR_API_TOKEN=<ISSUE_ONE_AND_PASTE_IT_HERE>
# Comma-separated browser origins, only if a web page calls the API directly.
FDR_CORS_ORIGINS=
# How long the gateway waits for one run, in seconds.
FDR_RUN_TIMEOUT=1800
# Finished job rows older than this are dropped at startup. Checkpoints are never touched.
FDR_JOB_RETENTION_DAYS=30
FDR_LOG_LEVEL=INFO

# --- Cloudflare tunnel ------------------------------------------------------
# Not here. The tunnel token lives in .env.tunnel (see .env.tunnel.example) so the cloudflared
# sidecar never receives the model key.
