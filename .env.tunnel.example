# Cloudflare tunnel credentials — used only by the cloudflared sidecar.
#
# Kept apart from .env so the sidecar does not receive the model key, and because compose reads
# this through env_file rather than variable substitution (substitution looks in docker/, not the
# repository root, and silently yields an empty token).
#
# Copy to .env.tunnel and paste the install token from the Zero Trust dashboard:
#   Networks > Tunnels > your tunnel > the token in the Docker connector command.
TUNNEL_TOKEN=<YOUR_TUNNEL_TOKEN>
