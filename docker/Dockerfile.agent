# docker/Dockerfile.agent — the LangGraph worker: graph, rubrics, Playwright and Chromium.
#
# The heavy image of the pair. Chromium and its system libraries are here and nowhere else, which
# is the point of splitting it from the gateway: a change to a route rebuilds a small image, and a
# change to the browser stack does not touch the process that answers the outside world.

FROM ghcr.io/astral-sh/uv:0.9-python3.12-bookworm-slim AS builder

WORKDIR /app

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

# Dependencies first, without the project, so a source edit does not re-resolve the lock.
COPY pyproject.toml uv.lock README.md ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project

COPY src/ ./src/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen


FROM python:3.12-slim-bookworm AS runtime

WORKDIR /app

# PLAYWRIGHT_BROWSERS_PATH puts Chromium outside any home directory, so the non-root user can read
# it. Without it Playwright looks under ~/.cache, which appuser does not have.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH" \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    TZ=Asia/Seoul

# fonts-noto-cjk is not incidental. The display-method check crops the rendered page and shows it
# to a vision model, so the page has to look the way it looks to a Korean user. Without a Korean
# font Chromium falls back to WenQuanYi, a Chinese face whose Hangul is legible but wrong — the
# model would be judging the prominence of type nobody is actually shown.
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        fonts-noto-cjk \
        tzdata \
    && ln -snf /usr/share/zoneinfo/$TZ /etc/localtime \
    && echo $TZ > /etc/timezone \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 1000 appuser \
    && useradd --uid 1000 --gid appuser --no-create-home appuser

COPY --from=builder --chown=appuser:appuser /app/.venv /app/.venv

# As root, before the USER switch: --with-deps installs Chromium's apt dependencies. The browser
# build has to match the pinned playwright wheel, so it is installed through that wheel.
RUN playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/* \
    && chmod -R a+rX /ms-playwright

COPY --chown=appuser:appuser src/ ./src/
COPY --chown=appuser:appuser docker/entrypoint-agent.sh /usr/local/bin/entrypoint-agent.sh
RUN chmod +x /usr/local/bin/entrypoint-agent.sh \
    && mkdir -p /app/data && chown appuser:appuser /app/data

USER appuser

EXPOSE 8100

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:8100/healthz || exit 1

ENTRYPOINT ["/usr/local/bin/entrypoint-agent.sh"]
CMD ["uvicorn", "financial_disclosure_review.serving.agent.app:app", \
     "--host", "0.0.0.0", "--port", "8100", \
     "--timeout-keep-alive", "1900"]
